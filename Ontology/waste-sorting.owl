                <owl:hasValue rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#residualBin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Wet or dirty textiles.</rdfs:comment>
    </owl:Class>
    


