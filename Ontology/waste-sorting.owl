    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#musicalGreetingCard">
        <rdf:type rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Paper_Product"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Paper"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasCleanliness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Clean_And_Dry"/>
            </owl:Restriction>
        </rdf:type>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasDirectComponent"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:oneOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#cardBattery"/>
                        </owl:oneOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdf:type>
        <hasDirectComponent rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#cardBattery"/>
        <rdfs:comment xml:lang="en">Rule conflict on purpose: both Paper_Bin_Waste and Battery_Containing_Item, so two routes. OWL cannot express that the battery rule should win; see the logic programming part.</rdfs:comment>
    </owl:NamedIndividual>
    


