<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#"
     xml:base="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting">
        <rdfs:comment xml:lang="en">This ontology is about waste sorting.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#accepts -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#accepts">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
        <rdfs:comment xml:lang="en">Inverse of disposedVia: which items a disposal route accepts.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#containsMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#containsMaterial">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Material"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="en">Every material an item contains, directly (madeOf) or through its components (property chain hasComponent o madeOf).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Disposal_Route"/>
        <rdfs:comment xml:lang="en">The disposal route (bin or drop-off point) an item belongs in.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasCleanliness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasCleanliness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cleanliness"/>
        <rdfs:comment xml:lang="en">Value partition: an item has exactly one cleanliness value.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
        <rdfs:comment xml:lang="en">Part-whole relation. Transitive: a part of a part is also a part of the whole.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasDirectComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasDirectComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent"/>
        <rdfs:comment xml:lang="en">Direct parts only. Simple (not transitive), so it may be used in cardinality restrictions, which OWL 2 DL forbids on transitive properties.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasFillState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasFillState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Fill_State"/>
        <rdfs:comment xml:lang="en">Value partition: empty or full.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasIntegrity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasIntegrity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Integrity"/>
        <rdfs:comment xml:lang="en">Value partition: intact or broken.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasSize -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasSize">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Size_Class"/>
        <rdfs:comment xml:lang="en">Value partition: fits in a bin or bulky (size as classes, no numbers).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasUseState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasUseState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Use_State"/>
        <rdfs:comment xml:lang="en">Value partition: used or unused.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#isComponentOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent"/>
        <rdfs:comment xml:lang="en">Inverse of hasComponent.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#containsMaterial"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Material"/>
        <rdfs:comment xml:lang="en">The main material of an item or component. Functional: further materials are modelled as components with their own madeOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasDeposit -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasDeposit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Packaging"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if the packaging carries a deposit (statiegeld).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Material"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Steel"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium_Coating -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium_Coating">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Coating"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Coating"/>
        <rdfs:comment xml:lang="en">A coating layer made of aluminium.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium_Foil -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium_Foil">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Packaging"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Aluminium"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Animal_Waste -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Animal_Waste">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Biodegradable_Waste"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Battery -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Battery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Electrical_Waste"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Battery_Containing_Item -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Battery_Containing_Item">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasComponent"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Built_In_Battery"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#collectionBox"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Items with a built-in battery, at any depth of the component structure.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Biodegradable_Waste -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Biodegradable_Waste">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bioplastic -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bioplastic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Plastic_Material"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Broken -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Broken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Integrity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Intact"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Built_In_Battery -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Built_In_Battery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Size_Class"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Fits_in_bin"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky_Garden_Waste -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky_Garden_Waste">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Garden_Waste"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Organic_Matter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasSize"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#recyclingCentre"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Plant_Waste"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cap -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cap">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Component"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cardboard -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cardboard">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Paper_Based_Material"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Paper"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cardboard_Box -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cardboard_Box">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Packaging"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cardboard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Carton_Laminate -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Carton_Laminate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Composite_Material"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cat_Litter -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cat_Litter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Animal_Waste"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#residualBin"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Chemical_Waste_Point -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Chemical_Waste_Point">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Drop_Off_Point"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Clean_And_Dry -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Clean_And_Dry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cleanliness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cleanliness -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Cleanliness">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Clean_And_Dry"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Food_Soiled"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Greasy"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Wet"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#State"/>
    </owl:Class>
    


