        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Deposit_Item -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Deposit_Item">
