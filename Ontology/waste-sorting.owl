    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Drop_Off_Waste -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Drop_Off_Waste">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Drop_Off_Point"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:comment xml:lang="en">Items you have to bring to a drop-off point.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Electrical_Waste -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Electrical_Waste">
