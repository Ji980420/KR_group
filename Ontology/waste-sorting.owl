    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mattress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Textile_Waste"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#hasSize"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Bulky"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#disposedVia"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#recyclingCentre"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Medicine -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Medicine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#containsMaterial"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Hazardous_Substance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Material -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Material">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Material"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Packaging -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Packaging">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Packaging"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Material"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Packaging"/>
        <rdfs:comment xml:lang="en">Packaging whose main material is a metal.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mirror -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mirror">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Glass_Product"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Flat_Glass"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mixed_Material_Item -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mixed_Material_Item">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#madeOf"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Glass_Material"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Paper_Based_Material"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#containsMaterial"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Metal_Material"/>
                                    <rdf:Description rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Plastic_Material"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Waste_Item"/>
        <rdfs:comment xml:lang="en">Paper or glass items with a plastic or metal part, found via the property chain.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mobile_Phone -->

    <owl:Class rdf:about="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Mobile_Phone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Small_Appliance"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/liji8/ontologies/2026/10/waste-sorting#Neighbourhood_Container -->

